# Copy this file to .env and fill in your keys.
# .env is gitignored.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: only needed for Lesson 03b (real embedding RAG).
OPENAI_API_KEY=

# Optional: override the default model used by lessons.
# Default if unset: claude-haiku-5-5
# Use claude-sonnet-5-5 for harder tasks, claude-opus-5-5 for the hardest.
LEARN_AGENTS_MODEL=

# Optional: default effort for every call (low, medium, high, xhigh, max).
# Unset means the model's own default (medium on Haiku 5.5). See Lesson 00c.
LEARN_AGENTS_EFFORT=

# Optional: only needed on corporate networks where uv downloads fail
# with `invalid peer certificate: UnknownIssuer`. Set in your shell, not here.
# UV_SYSTEM_CERTS=true
