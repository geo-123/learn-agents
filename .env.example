# Copy this file to .env and fill in your keys.
# .env is gitignored.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: only needed for Lesson 03b (real-embedding RAG).
OPENAI_API_KEY=

# Optional: override the default model used by lessons.
# Default if unset: claude-haiku-4-5
# Use claude-sonnet-4-5 for harder tasks (judge models, complex extractions).
LEARN_AGENTS_MODEL=

# Optional: only needed on corporate networks where uv downloads fail
# with `invalid peer certificate: UnknownIssuer`. Set in your shell, not here.
# UV_NATIVE_TLS=true
